# Copia este fichero a .env.local y ajusta los valores. No subas .env.local al repositorio.

# URL pública del sitio, sin barra final. Se usa para las URL canónicas, el sitemap,
# robots.txt y las etiquetas Open Graph. Se lee en la compilación (npm run build).
# Valor por defecto si no se define: https://dgt-pulse.es
NEXT_PUBLIC_SITE_URL=https://dgt-pulse.es

# Carpeta con los ZIP mensuales de microdatos de la DGT (export_mensual_mat_*.zip).
# Solo la usa el proceso de ingesta (npm run ingest), no la web. Si no se define o la
# carpeta no existe, la ingesta usa la base de datos local data/dgt_database.db.
# Ejemplo en Windows: DGT_MICRODATA_DIR=C:\datos\dgt
# Ejemplo en Linux:   DGT_MICRODATA_DIR=/datos/dgt
DGT_MICRODATA_DIR=
